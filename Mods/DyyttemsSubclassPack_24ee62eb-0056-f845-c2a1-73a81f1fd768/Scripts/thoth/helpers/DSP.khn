function IceKnifeCheck()
    return SpellId('Projectile_IceKnife') | SpellId('Projectile_IceKnife_2') | SpellId('Projectile_IceKnife_3') | SpellId('Projectile_IceKnife_4') | SpellId('Projectile_IceKnife_5') | SpellId('Projectile_IceKnife_6') | SpellId('Projectile_IceKnife_7') | SpellId('Projectile_IceKnife_8') | SpellId('Projectile_IceKnife_9')
end

function IsIceKnife()
    return SpellId('Projectile_IceKnife') or SpellId('Projectile_IceKnife_2') or SpellId('Projectile_IceKnife_3') or SpellId('Projectile_IceKnife_4') or SpellId('Projectile_IceKnife_5') or SpellId('Projectile_IceKnife_6') or SpellId('Projectile_IceKnife_7') or SpellId('Projectile_IceKnife_8') or SpellId('Projectile_IceKnife_9')
end

function HasArmorOfAgathys()
    return HasStatus('ARMOR_OF_AGATHYS') or HasStatus('ARMOR_OF_AGATHYS_2') or HasStatus('ARMOR_OF_AGATHYS_3') or HasStatus('ARMOR_OF_AGATHYS_4') or HasStatus('ARMOR_OF_AGATHYS_5') or HasStatus('ARMOR_OF_AGATHYS_7') or HasStatus('ARMOR_OF_AGATHYS_8') or HasStatus('ARMOR_OF_AGATHYS_9')
end

function HasArmorOfAgathysContext()
    return HasStatus('ARMOR_OF_AGATHYS',context.Target) or HasStatus('ARMOR_OF_AGATHYS_2',context.Target) or HasStatus('ARMOR_OF_AGATHYS_3',context.Target) or HasStatus('ARMOR_OF_AGATHYS_4',context.Target) or HasStatus('ARMOR_OF_AGATHYS_5',context.Target) or HasStatus('ARMOR_OF_AGATHYS_6',context.Target) or HasStatus('ARMOR_OF_AGATHYS_7',context.Target) or HasStatus('ARMOR_OF_AGATHYS_8',context.Target) or HasStatus('ARMOR_OF_AGATHYS_9',context.Target)
end